# Docker build context: keep it small and free of secrets / host-only data.
# The image is built from tracked source; real config lives in the deployment
# bundle and is mounted at runtime.

# VCS / local environments
.git
.gitignore
.venv
.conda
.conda-pkgs

# Python caches and build output
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
.eggs
*.egg-info
build
dist
*.tar.gz

# Node
**/node_modules
**/dist
frontend/webapp/tsconfig.tsbuildinfo

# Local runtime data / user settings / secrets
.openharness
.agents
.claude
config/backend/.env
config/backend/.env_dev
config/backend/.env.bak-*
config/frontend/.env
config/frontend/.env_dev
config/**/.env.local

# Not needed at runtime
assets
docs
tests
.github
CHANGELOG.md
CONTRIBUTING.md
.DS_Store
Thumbs.db
