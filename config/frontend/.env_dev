# 开发环境前端配置模板。使用：cp config/frontend/.env_dev config/frontend/.env
VITE_APP_NAME=智能问答
VITE_APP_SUBTITLE=企业级 AI 助手
VITE_PRODUCT_NAME=ABCHarness
VITE_APP_DESCRIPTION=企业级 AI 助手：支持多智能体编排、文件分析、执行过程展示与选项式确认。
VITE_DEV_PORT=5174
# Vite dev server 所在机器访问后端的地址（同机用回环即可，不要写死本机局域网 IP）
VITE_API_TARGET=http://192.168.139.144:8787
# 留空 = 浏览器同源请求，由 Vite 代理转发，无需 CORS
VITE_API_BASE_URL=http://192.168.139.144:8787
VITE_API_TOKEN=
