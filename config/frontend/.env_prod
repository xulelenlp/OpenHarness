# 生产环境前端配置模板。使用：cp config/frontend/.env_prod config/frontend/.env
VITE_APP_NAME=智能问答
VITE_APP_SUBTITLE=企业级 AI 助手
VITE_PRODUCT_NAME=ABCHarness
VITE_APP_DESCRIPTION=企业级 AI 助手：支持多智能体编排、文件分析、执行过程展示与选项式确认。
VITE_DEV_PORT=5174
# 生产构建 / preview 时，Vite 代理转发后端的地址（同机用回环即可）
VITE_API_TARGET=http://127.0.0.1:8787
# 留空 = 同源（推荐：后端 static_dir 托管前端产物，或前置反向代理同端口转发）。
# 只有「前端与后端是不同站点域名，且 API 已对外暴露」时才填绝对地址；
# 内外网多入口必须留空（见 DEPLOYMENT §8.1）。
VITE_API_BASE_URL=
VITE_API_TOKEN=
