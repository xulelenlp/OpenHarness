            "choices[0].text",
            "delta",
            "content",
            "answer",
            "message",
            "data",
            "text",
            "output",
            "result"
          ],
          "extract_tags": [
            "answer"
          ]
        },
        "config": {
          "endpoint": "${POWER_GRID_AGENT_ENDPOINT}",
          "method": "POST",
          "headers": {
            "content-type": "application/json"
