# 生产环境配置模板。使用：cp config/backend/.env_prod config/backend/.env
# 复制后填写真实密钥；.env 已在 .gitignore 中。

# ---- OpenHarness 模型 ----
OPENHARNESS_PROFILE=prod
OPENHARNESS_DASHSCOPE_API_KEY=
OPENHARNESS_OPENAI_API_KEY=

# ---- qaapp Web 服务 ----
QAAPP_HOST=0.0.0.0
QAAPP_PORT=8787
QAAPP_API_TOKENS=
QAAPP_CORS_ORIGINS=*
QAAPP_STATIC_DIR=frontend/webapp/dist
QAAPP_PROVIDER_PROFILE=
QAAPP_BROWSER_AUTH_ENABLED=true
QAAPP_APPROVAL_TIMEOUT_SECONDS=300

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=
DB_NAME=ai_search_fj

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 外部 Agent 端点 / 参数 ----
POWER_GRID_AGENT_ENDPOINT=http://your-agent-host:18081/api/chat/stream
SMART_QUERY_AGENT_ENDPOINT=http://your-agent-host:18094/chat_agent_roll
KNOWLEDGE_AGENT_ENDPOINT=http://your-agent-host:18094/chat_agent_roll
EXTERNAL_AGENT_USER_ID=YOUR_USER_ID
EXTERNAL_AGENT_ORG_CODE=YOUR_ORG_CODE
