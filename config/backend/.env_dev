# 开发环境配置模板。使用：cp config/backend/.env_dev config/backend/.env
# 本文件是唯一配置来源：模型 / 凭据 / 服务 / 数据源全部在这里维护。

# ---- OpenHarness 模型（原 config/backend/settings.json 已合并到本文件）----
# 唯一配置来源：provider / model / base_url / 凭据来源都在这里维护。
# 密钥可以直接写 OPENHARNESS_API_KEY（优先级最高），或写到 AUTH_SOURCE 指向的
# 内置变量（dashscope_api_key → OPENHARNESS_DASHSCOPE_API_KEY，
# openai_api_key → OPENHARNESS_OPENAI_API_KEY）。
OPENHARNESS_PROFILE=dev
OPENHARNESS_PROVIDER=openai
OPENHARNESS_API_FORMAT=openai
OPENHARNESS_MODEL=deepseek-flash
OPENHARNESS_BASE_URL=http://ai.ac-energytech.com/v1
OPENHARNESS_AUTH_SOURCE=dashscope_api_key
OPENHARNESS_API_KEY=sk-96Uy23xRBP09simq6L1QgRVdWskjxwpwHUzzKfV2cFVoemYn
OPENHARNESS_DASHSCOPE_API_KEY=sk-96Uy23xRBP09simq6L1QgRVdWskjxwpwHUzzKfV2cFVoemYn
OPENHARNESS_OPENAI_API_KEY=
OPENHARNESS_MAX_TOKENS=16384
OPENHARNESS_TIMEOUT=30
OPENHARNESS_MAX_TURNS=200
OPENHARNESS_PRODUCT_NAME=ABC Tech
OPENHARNESS_SLOGAN=企业级AI助手
OPENHARNESS_ALLOW_PROJECT_PLUGINS=true
OPENHARNESS_PROJECT_SKILL_DIRS=.openharness/skills,.agents/skills,.claude/skills,skills

# ---- qaapp Web 服务 ----
QAAPP_HOST=0.0.0.0
QAAPP_PORT=8787
QAAPP_API_TOKENS=
QAAPP_CORS_ORIGINS=*
QAAPP_STATIC_DIR=
QAAPP_PROVIDER_PROFILE=
QAAPP_BROWSER_AUTH_ENABLED=true
QAAPP_APPROVAL_TIMEOUT_SECONDS=300

# ---- MySQL（datasources.json 用 ${DB_*} 引用）----
DB_HOST=47.117.162.103
DB_PORT=13306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_search_fj

# ---- Redis ----
REDIS_HOST=47.117.162.103
REDIS_PORT=16379
REDIS_PASSWORD=

# ---- 外部 Agent 端点 / 参数 ----
EXTERNAL_AGENT_USER_ID=YOUR_USER_ID
EXTERNAL_AGENT_ORG_CODE=YOUR_ORG_CODE
