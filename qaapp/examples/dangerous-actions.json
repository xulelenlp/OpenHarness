{
  "_comment": "高危操作策略。放置到 ~/.ohmo/dangerous-actions.json。工具名为 OpenHarness 真实工具名（write_file / read_file / edit_file / bash 等）。",
  "approval_timeout_seconds": 300,
  "rules": [
    {
      "tool": "write_file",
      "action": "confirm",
      "reason": "创建/写入文件属于高危操作，需人工确认"
    },
    {
      "tool": "edit_file",
      "action": "confirm",
      "reason": "修改文件内容需人工确认"
    },
    {
      "tool": "bash",
      "action": "confirm",
      "deny_commands": ["rm -rf *", "rm -fr *", "sudo *", "shutdown *", "reboot *", "mkfs.*"],
      "confirm_commands": ["pip install*", "npm install*", "git push*"],
      "reason": "执行 shell 命令需确认；删除/提权等危险命令直接拒绝"
    },
    {
      "tool": "*",
      "action": "deny",
      "paths": ["**/*.pem", "**/*.key", "**/.env", "**/.ssh/**", "**/id_rsa*"],
      "reason": "敏感文件（密钥/环境变量/SSH）禁止读写"
    }
  ]
}
